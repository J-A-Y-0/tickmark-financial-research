# Copy to .env and fill in what you use. Never commit .env.
# With nothing set, Tickmark runs fully offline: heuristic planner, keyword router,
# extractive answers, hashing embeddings, no web search.

# --- Language model -------------------------------------------------------------
LLM_PROVIDER=offline            # offline | openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# ANSWER_MODEL=gpt-5.5          # defaults: gpt-5.5 / claude-sonnet-5-5
# FAST_MODEL=gpt-5.4-mini       # planning and the LLM router; defaults: gpt-5.4-mini / claude-haiku-5-5

# --- Embeddings -----------------------------------------------------------------
EMBEDDING_PROVIDER=hashing      # hashing (offline) | openai
# EMBEDDING_MODEL=text-embedding-3-small

# --- Routing --------------------------------------------------------------------
ROUTER=keyword                  # keyword | llm | jev | cascade (default: llm when a provider is set)
TYPESAFE_API_KEY=               # enables the jev and cascade routers
# JEV_MODEL=jev-latest
# CASCADE_THRESHOLD=0.8         # below this Jev confidence, the cascade asks the LLM
# VERIFIER=lexical              # lexical | jev (adds a semantic support check)

# --- Web search -----------------------------------------------------------------
SEARCH_PROVIDER=none            # tavily | serpapi | none
SEARCH_FALLBACK=none            # used when the primary provider fails
TAVILY_API_KEY=
SERPAPI_API_KEY=

# --- Limits and storage ---------------------------------------------------------
# DATABASE_PATH=var/tickmark.sqlite3
# DAILY_BUDGET_USD=5.0          # per user per day
# DEEP_DAILY_CAP=5              # deep research runs per user per day
# QUICK_TIMEOUT_S=90
# DEEP_TIMEOUT_S=240
# CACHE_SIMILARITY=0.92
# CACHE_TTL_HOURS=24
# MAX_UPLOAD_MB=25

# Override a list price (USD per million tokens, "input,output"):
# TICKMARK_PRICE_GPT_5_5=5.00,30.00

# Only for data/build_filings.py (SEC requires a contact in the User-Agent):
# SEC_USER_AGENT="Your Name you@example.com"
